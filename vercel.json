{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev && npm ci --prefix server",
  "buildCommand": "CI=1 npx expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/socket.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/((?!api/|_expo/|assets/).*)", "destination": "/index.html" }
  ]
}
